# Supabase — copiá estos valores de tu proyecto en Supabase:
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key

# Clave secreta (service_role) — SOLO se usa en el servidor, nunca en el browser.
# Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URL pública del sitio (para armar los magic links). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp de Pablo para el botón "Agendar llamada" del informe (opcional).
# Con código de país, sin + ni espacios. Ej.: 5491100000000
NEXT_PUBLIC_PABLO_WHATSAPP=

# --- Notificaciones (opcional para arrancar) ---
# A dónde avisar cuando un lead carga datos. Dejalo vacío para desactivar.
NOTIFY_EMAIL=
# Si usás un servicio de email tipo Resend, su API key:
RESEND_API_KEY=
